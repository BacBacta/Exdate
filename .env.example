# ---------------------------------------------------------------------------
# Robinhood Chain (chainId 4663)
# ---------------------------------------------------------------------------
# Public endpoint: works, but heavily rate limited (HTTP 429) and eth_getLogs
# times out on wide ranges. Fine for spot reads and for the Phase 0 scripts.
# A dedicated provider is required for the indexer backfill.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Dedicated / archive endpoint used by the indexer (QuickNode, Chainstack, dRPC...).
# Leave empty to fall back to RHC_RPC_URL.
RHC_RPC_URL_ARCHIVE=

# Where Ponder starts indexing UIMultiplierUpdated. Leave EMPTY to start at the
# head, which is the default and the right choice on the public RPC: it cannot
# walk 51.7M blocks (see docs/phase-0-verification.md section 13). History comes
# from scripts/backfill-multiplier-events.mjs instead.
# Set to 900000 once RHC_RPC_URL_ARCHIVE points at a dedicated provider.
RHC_START_BLOCK=

# Minimum gap between two RPC calls, ms. The transport retries rejections rather
# than relying on this, so the default is low.
RHC_RPC_MIN_GAP_MS=80

# Max block range per eth_getLogs. Verified: 5,000,000 answers in under a second
# when filtered on all 194 addresses plus a topic.
RHC_GET_LOGS_BLOCK_RANGE=2000000

# Blocks between polls of the ERC-8056 views and the Chainlink feeds.
# ~0.1 s per block, so 600 is about a minute.
EXDATE_POLL_INTERVAL_BLOCKS=600

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Leave empty to use the embedded PGlite database under packages/indexer/.ponder.
DATABASE_URL=

# Where the status page reads the API.
EXDATE_API_URL=http://localhost:42069

# ---------------------------------------------------------------------------
# Issuer REST API (no auth). Dividends, splits, raw underlying prices, registry.
# See docs.robinhood.com/chain/stock-token-apis. Rate limited in practice:
# /prices answers the plain-text body "local_rate_limited" after a few calls.
# ---------------------------------------------------------------------------
ROBINHOOD_API_BASE=https://api.robinhood.com/rhj

# Optional third-party market data (ex-dates, pay-dates, pre-August history).
# NOT required for M1-M3: the issuer API above covers the reconciliation table.
MARKET_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Webhooks (M4)
# ---------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=
