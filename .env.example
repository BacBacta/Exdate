# ---------------------------------------------------------------------------
# Robinhood Chain (chainId 4663)
# ---------------------------------------------------------------------------
# Public endpoint: works, but heavily rate limited (HTTP 429) and eth_getLogs
# times out on wide ranges. Fine for spot reads and for the Phase 0 scripts.
# A dedicated provider is required for the indexer backfill.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Dedicated / archive endpoint used by the indexer (QuickNode, Chainstack, dRPC...).
# Leave empty to fall back to RHC_RPC_URL.
RHC_RPC_URL_ARCHIVE=

# Block to start indexing from. See docs/phase-0-verification.md.
RHC_START_BLOCK=900000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/exdate

# ---------------------------------------------------------------------------
# Traditional corporate-action data (dividends, splits, ex-dates).
# Needed for the reconciliation table. Provider not yet chosen - see M2.
# ---------------------------------------------------------------------------
MARKET_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Webhooks (M4)
# ---------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=
