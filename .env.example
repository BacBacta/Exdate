# ---------------------------------------------------------------------------
# Robinhood Chain (chainId 4663)
# ---------------------------------------------------------------------------
# This file is read by `pnpm dev`, `pnpm dev:status` and `pnpm start`, which copy
# it to packages/indexer/.env.local and apps/status/.env.local first (Ponder and
# Next only read those). Edit the root .env; never the copies.
#
# Which endpoints read the chain, in order, tried left to right. Leave empty for
# the built-in order: a measured third-party endpoint first, Robinhood's own as
# the fallback. That order is a terms decision (docs/terms-review.md): the chain
# itself is outside Robinhood's Terms of Service, its public RPC is a "Service"
# bound to "testing, experimentation, evaluation, and development" and "not
# intended for production-grade" use - so production reads go to a third party
# and touch Robinhood's endpoint only when that one fails. A paid provider from
# the list on docs.robinhood.com/chain/run-a-full-node (Alchemy, Quicknode,
# Chainstack, dRPC...) adds the one thing the free endpoints lack, a service
# commitment: put its URL first here.
#
# What to size it for, measured on 2026-09-04 through a counting proxy:
#   watcher            5 760 requests/day   (0.17 M/month)  - fits any free tier
#   collectors         1 232 requests/day   (0.04 M/month)
#   indexer (Ponder) 166 000-348 000/day    (5-10 M/month)  - needs a paid tier
# The indexer is ~90 % eth_getBlockByNumber at the head. Raising pollingInterval
# does not help; it was tried and measured and made the rate worse.
RHC_RPC_URLS=
# One endpoint, no failover. Kept for compatibility; RHC_RPC_URLS wins when set.
RHC_RPC_URL=

# An endpoint that keeps state at any height. Robinhood's own does not: eth_call a
# few thousand blocks back answers `metadata is not found`. Public endpoints that
# do are measured in data/rpc-endpoints.observed.json (node
# scripts/probe-rpc-endpoints.mjs); two reach the oldest multiplier step, and they
# are third parties with no service commitment. Paid providers also sell this chain.
# Leave empty to fall back to RHC_RPC_URL, which means no historical state.
RHC_RPC_URL_ARCHIVE=

# Where Ponder starts indexing UIMultiplierUpdated. Leave EMPTY to start at the
# head, which is the default and the right choice on the public RPC: it cannot
# walk 51.7M blocks (see docs/phase-0-verification.md section 13). History comes
# from scripts/backfill-multiplier-events.mjs instead.
# Set to 900000 once RHC_RPC_URL_ARCHIVE points at a dedicated provider.
RHC_START_BLOCK=

# Minimum gap between two RPC calls, ms. The transport retries rejections rather
# than relying on this, so the default is low.
RHC_RPC_MIN_GAP_MS=80

# Max block range per eth_getLogs. Verified: 5,000,000 answers in under a second
# when filtered on all 194 addresses plus a topic.
RHC_GET_LOGS_BLOCK_RANGE=2000000

# Blocks between polls of the ERC-8056 views and the Chainlink feeds.
# ~0.1 s per block, so 600 is about a minute.
EXDATE_POLL_INTERVAL_BLOCKS=600

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Leave empty to use the embedded PGlite database under packages/indexer/.ponder.
DATABASE_URL=
# Postgres schema for `ponder start` (Ponder refuses to start on Postgres without one).
DATABASE_SCHEMA=exdate

# Where the status page reads the API.
EXDATE_API_URL=http://localhost:42069

# ---------------------------------------------------------------------------
# Issuer REST API. Not configurable: the base URL is a constant in
# packages/core/src/chains.ts (ROBINHOOD_API_BASE), because it is the one
# first-party source and a mock would defeat the point. Documented here so
# nobody looks for the knob.
# ---------------------------------------------------------------------------

# Chunk size for scripts/backfill-multiplier-events.mjs. 2,000,000 verified.
BACKFILL_CHUNK_BLOCKS=2000000

# Set to 1 to run the live-chain integration tests in packages/core.
EXDATE_INTEGRATION=

# Set to 1 to log the head and tail of every eth_getLogs body the poller's
# gap sweep sends. The public RPC pool occasionally answers -32602 "Missing or
# invalid parameters" to a request it accepted a minute earlier; the sweep then
# leaves its marker in place and retries on the next poll.
EXDATE_DEBUG_RPC=

# Optional third-party market data (ex-dates, pay-dates, pre-August history).
# NOT required for M1-M3: the issuer API covers the reconciliation table.
MARKET_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Webhooks (M4)
#
# Endpoints are configuration, not data: they carry the signing secret, so they
# live here and never in a table the API serves. A JSON array of
# {id, url, secret, events?}; omit `events` to receive every type. The list is
# parsed at boot and a malformed entry stops the process - silence from a typo
# would be indistinguishable from silence because nothing happened.
#
# `url` must be https, except on localhost. `secret` must be at least 16
# characters; generate one with `openssl rand -hex 32` and keep it out of git.
# Signature: HMAC-SHA256 over `${t}.${body}`, sent as
#   exdate-signature: t=<unix seconds>,v1=<hex>
# Verify it with verifySignature() from @exdate/core, against the RAW body.
# GET /v1/webhooks serves the event catalogue and the scheme.
#
# Example (single line, no secrets in git):
#   EXDATE_WEBHOOK_ENDPOINTS=[{"id":"curator","url":"https://hooks.example.com/exdate","secret":"REPLACE_ME","events":["dividend.reconciled","feed.stale"]}]
# ---------------------------------------------------------------------------
EXDATE_WEBHOOK_ENDPOINTS=

# Per-attempt HTTP timeout, milliseconds.
EXDATE_WEBHOOK_TIMEOUT_MS=10000

# Most deliveries attempted per poll cycle, so a backlog cannot stretch a poll.
EXDATE_WEBHOOK_MAX_PER_POLL=20

# Self-service subscriptions: POST /v1/webhooks/subscriptions lets a consumer
# subscribe an https endpoint and receive a secret once. They are kept in one
# file the process owns (mode 0600), never in a table the API serves.
#   EXDATE_WEBHOOK_SELF_SERVICE=false     turns the routes off (501)
#   EXDATE_WEBHOOK_SUBSCRIPTIONS_FILE     where the file lives; a volume in Docker
#   EXDATE_WEBHOOK_ALLOW_PRIVATE=true     accept localhost and private addresses (your own instance only)
EXDATE_WEBHOOK_SELF_SERVICE=true
EXDATE_WEBHOOK_SUBSCRIPTIONS_FILE=.exdate/webhook-subscriptions.json
EXDATE_WEBHOOK_ALLOW_PRIVATE=false

# How long an observed Chainlink round is kept in feed_rounds, in days. 0 keeps
# everything. This table is an observation log, not the price history: historical
# prices are read back from the aggregator's own getRoundData (see
# packages/core/src/rounds.ts), so pruning it loses nothing. The newest round of
# each feed is always kept.
EXDATE_FEED_ROUNDS_RETENTION_DAYS=30

# --- API keys and quotas ------------------------------------------------------
# Keys as key:label:requestsPerMinute, comma separated. The label is what
# /v1/me and the logs show; the key itself never leaves the process. Empty
# means the API is open at the anonymous rate. An unknown key is refused (401),
# never downgraded to anonymous.
#   EXDATE_API_KEYS=k_live_0123456789abcdef:acme:600,k_live_fedcba9876543210:curator-x:6000
EXDATE_API_KEYS=
# Requests per minute for callers without a key, counted per client address
# (X-Forwarded-For first, then X-Real-IP). Default 60.
EXDATE_ANON_RPM=60
# Default per-minute quota for a key that states none. Default 600.
EXDATE_KEY_RPM=600

# --- alerts -------------------------------------------------------------------
# Where the announcement goes. A multiplier change is published on chain about nine
# minutes before it takes effect; these are the addresses that get told. Set none and
# scripts/notify.mjs does nothing and says so. In CI these are repository secrets of
# the same names, read by .github/workflows/capture-effective-prices.yml.
#
# A Discord or Slack incoming webhook, or any endpoint accepting { content, text }:
EXDATE_ALERT_WEBHOOK_URL=
# Telegram needs both:
EXDATE_TELEGRAM_BOT_TOKEN=
EXDATE_TELEGRAM_CHAT_ID=
# Prefixes the token links in a notice. Defaults to the production site.
EXDATE_SITE_URL=
# An announcement seen later than this many seconds after it was published is not
# sent: delivering it would report a lead rather than give one. Default 3600.
EXDATE_NOTIFY_MAX_AGE=

# --- capture: the issuer's quote at the instant of a step ----------------------
# scripts/capture-effective-prices.mjs runs on GitHub's schedule and waits this
# long, in ms, for an effectiveAt it has seen announced. Nine minutes is the lead.
# In CI this is the repository *variable* EXDATE_CAPTURE_BUDGET_MS.
EXDATE_CAPTURE_BUDGET_MS=540000
# `capture` (default): scan and sample on every run. `watchdog`: only check that
# scripts/watch-effective-prices.mjs is alive, and capture while it is not.
# Set the repository variable EXDATE_CAPTURE_MODE=watchdog once the watcher runs.
EXDATE_CAPTURE_MODE=

# --- watcher: the same capture as a process that stays alive ------------------
# scripts/watch-effective-prices.mjs, on a machine (deploy/exdate-watcher.service
# or the `watcher` service in docker-compose.yml). Needs a clone it may push to and
# a deploy key with write access; it reads the alert sinks above.
# Seconds between scans. Thirty is far inside the nine-minute lead.
EXDATE_WATCH_TICK_MS=30000
# A heartbeat commit at least this often, even when nothing happened. The watchdog
# on GitHub treats a heartbeat older than seven hours as a dead process.
EXDATE_WATCH_HEARTBEAT_MS=21600000
# `false` runs the watcher without committing or pushing, for a trial.
EXDATE_WATCH_PUSH=
