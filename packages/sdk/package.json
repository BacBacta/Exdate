{
  "name": "@exdate/sdk",
  "version": "0.1.0",
  "description": "Typed client and webhook verifier for the exdate API: multipliers, pending dividends, reconciled haircuts for tokenized stocks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BacBacta/Exdate.git",
    "directory": "packages/sdk"
  },
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@exdate/core": "workspace:*"
  },
  "devDependencies": {
    "@exdate/api": "workspace:*",
    "typescript": "^5.9.0",
    "@types/node": "^22.15.0",
    "vitest": "^4.1.11",
    "vite": "^7.1.14"
  }
}
