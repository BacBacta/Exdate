{
  "name": "@exdate/core",
  "version": "0.1.0",
  "description": "Chains, ABIs, WAD maths, reconciliation and the address codecs behind exdate, the corporate-action layer for tokenized stocks. Pure: no I/O.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BacBacta/Exdate.git",
    "directory": "packages/core"
  },
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./webhooks": "./src/webhooks.ts",
    "./yield": "./src/yield.ts",
    "./pending": "./src/pending.ts",
    "./holdings": "./src/holdings.ts",
    "./chains": "./src/chains.ts",
    "./quotes": "./src/quotes.ts",
    "./pools": "./src/pools.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./webhooks": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "./yield": {
        "types": "./dist/yield.d.ts",
        "default": "./dist/yield.js"
      },
      "./pending": {
        "types": "./dist/pending.d.ts",
        "default": "./dist/pending.js"
      },
      "./holdings": {
        "types": "./dist/holdings.d.ts",
        "default": "./dist/holdings.js"
      },
      "./chains": {
        "types": "./dist/chains.d.ts",
        "default": "./dist/chains.js"
      },
      "./quotes": {
        "types": "./dist/quotes.d.ts",
        "default": "./dist/quotes.js"
      },
      "./pools": {
        "types": "./dist/pools.d.ts",
        "default": "./dist/pools.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vite": "^7.1.14",
    "@types/node": "^22.15.0"
  }
}
